{
  "name": "openclaw-meals-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "Agent-scoped meal plans, grocery lists, and optional flyer deal search for OpenClaw.",
  "license": "MIT",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.22.1"
  },
  "dependencies": {
    "typebox": "1.4.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.3"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "openclaw": "2026.11.3",
    "typescript": "5.9.3"
  },
  "scripts": {
    "build": "esbuild src/*.ts --platform=node --format=esm --outdir=dist --packages=external",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.3",
      "minGatewayVersion": "2026.11.3"
    },
    "build": {
      "openclawVersion": "2026.11.3",
      "pluginSdkVersion": "2026.11.3"
    }
  }
}
